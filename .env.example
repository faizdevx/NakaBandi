# Copy to .env. Never commit .env. All keys stay on the server.

# Traffic provider, required for traffic data. Free tier, no card: https://developer.tomtom.com
# TomTom is used when both keys are set.
TOMTOM_API_KEY=
HERE_API_KEY=

# Protects the AI settings endpoint. Without it, settings are read-only.
ADMIN_TOKEN=

# AI provider, optional: openai | gemini | ollama. Without it, reports are statistical only.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_URL=
OLLAMA_MODEL=llama3.2

# Cache. Empty means in-process memory. Docker Compose sets this for you.
REDIS_URL=

# History archive, optional. Check your traffic provider's storage terms before enabling.
# With Docker: docker compose --profile history up, and set
# DATABASE_URL=postgresql://nakabandi:nakabandi@db:5432/nakabandi
DATABASE_URL=

FLOW_TTL_SECONDS=900
NATIONAL_TTL_SECONDS=10800

# Daily guards that keep TomTom inside its free monthly quota.
FLOW_DAILY_BUDGET=600
TILE_DAILY_BUDGET=6000
INCIDENT_DAILY_BUDGET=75
